# Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=clinic_db

# ------------------------------------------------------------------------------
# Database User & Password Defaults by Platform:
# 
# 1. Windows (XAMPP default):
#    DB_USER=root
#    DB_PASS=
#
# 2. Linux (LAMP / WSL Ubuntu default):
#    DB_USER=clinic_user
#    DB_PASS=apna_password
# ------------------------------------------------------------------------------
DB_USER=root
DB_PASS=

# Application Environment Mode
APP_ENV=development
